# ============================================================
# VoltAgent & OpenRouter Configuration
# ============================================================
PORT=8000
NODE_ENV=development

# Paste your OpenRouter API Key below:
# Format: sk-or-v1-...
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Default Model: can use openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct, google/gemini-2.0-flash-001, anthropic/claude-3.5-haiku, etc.
OPENROUTER_MODEL=openai/gpt-4o-mini
