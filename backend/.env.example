# ============================================================
# Server Configuration
# ============================================================
PORT=5000
NODE_ENV=development

# ============================================================
# Neon PostgreSQL Database Connection
# ============================================================
# Paste your Neon connection string below (recommended):
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional separate DB parameters (if not using DATABASE_URL):
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=smart_pharmacy
DB_SSL=true

# ============================================================
# Authentication Security
# ============================================================
JWT_SECRET=replace_with_a_secure_jwt_random_secret_string

# ============================================================
# AI/ML Micro-Service
# ============================================================
AI_SERVICE_URL=http://localhost:8000
